<idea-plugin>
    <id>com.jakubjirak.gpudev.ultimate</id>
    <name>GPU Dev Accelerator Ultimate</name>
    <vendor email="support@jakubjirak.com" url="https://jakubjirak.com">Jakub Jirak</vendor>
    
    <product-descriptor code="PGPUDEVACCELERA" release-date="20260215" release-version="20262" optional="true"/>

    <description><![CDATA[
<h2>GPU Dev Accelerator Ultimate</h2>
<p>
  The ultimate GPU development toolkit for JetBrains IDEs. GPU Dev Accelerator Ultimate delivers full IDE
  support for CUDA, Metal, OpenCL, and Vulkan Compute — including syntax highlighting, debugging, profiling,
  and AI-powered kernel optimization across all major GPU platforms.
</p>

<h2>Key Features</h2>
<ul>
  <li><b>Multi-Platform GPU Support</b> — CUDA, Metal Shading Language, OpenCL, and Vulkan Compute</li>
  <li><b>Advanced Debugging</b> — Integrated cuda-gdb, thread-level inspection, memory error detection</li>
  <li><b>Performance Profiling</b> — nvprof, Nsight Compute, and Metal Performance Shaders integration</li>
  <li><b>Memory Analysis</b> — GPU memory leak detection and allocation tracking</li>
  <li><b>AI Kernel Optimization</b> — Intelligent suggestions for occupancy, memory coalescing, and warp divergence</li>
  <li><b>Multi-GPU Topology</b> — Visualize and target specific GPU devices</li>
</ul>

<h2>Why GPU Dev Accelerator Ultimate?</h2>
<p>
  GPU development has been stuck in command-line workflows for too long. This plugin brings the full power
  of modern IDE features to GPU programming — making kernel development as productive as CPU code.
</p>

<h2>Free vs Pro</h2>
<ul>
  <li><b>Free:</b> Syntax highlighting, basic code completion, compilation support for all GPU platforms</li>
  <li><b>Pro:</b> Advanced debugging, profiler integration, AI kernel optimization, memory analysis, multi-GPU topology, warp divergence analysis, and team collaboration features</li>
</ul>
]]></description>

    <change-notes><![CDATA[
        <h3>Version 2025.1.1</h3>
        <ul>
            <li>Added freemium pricing model with product code PGPUDEVACCELERA</li>
            <li>Initial release with full CUDA and Metal support</li>
            <li>Advanced debugging and profiling capabilities</li>
            <li>AI-powered kernel optimization</li>
            <li>Multi-GPU workload visualization</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Types -->
        <fileType name="CUDA" implementationClass="com.gpudev.accelerator.cuda.CudaFileType" 
                  fieldName="INSTANCE" language="CUDA" extensions="cu;cuh"/>
        <fileType name="Metal" implementationClass="com.gpudev.accelerator.metal.MetalFileType" 
                  fieldName="INSTANCE" language="Metal" extensions="metal"/>
        <fileType name="OpenCL" implementationClass="com.gpudev.accelerator.opencl.OpenCLFileType" 
                  fieldName="INSTANCE" language="OpenCL" extensions="cl"/>
        
        <!-- Languages -->
        <lang.parserDefinition language="CUDA" implementationClass="com.gpudev.accelerator.cuda.CudaParserDefinition"/>
        <lang.parserDefinition language="Metal" implementationClass="com.gpudev.accelerator.metal.MetalParserDefinition"/>
        <lang.parserDefinition language="OpenCL" implementationClass="com.gpudev.accelerator.opencl.OpenCLParserDefinition"/>
        
        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory language="CUDA" implementationClass="com.gpudev.accelerator.cuda.CudaSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="Metal" implementationClass="com.gpudev.accelerator.metal.MetalSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="OpenCL" implementationClass="com.gpudev.accelerator.opencl.OpenCLSyntaxHighlighterFactory"/>
        
        <!-- Code Completion -->
        <completion.contributor language="CUDA" implementationClass="com.gpudev.accelerator.cuda.CudaCompletionContributor"/>
        <completion.contributor language="Metal" implementationClass="com.gpudev.accelerator.metal.MetalCompletionContributor"/>
        
        <!-- Debugger -->
        <programRunner implementation="com.gpudev.accelerator.debugger.CudaDebugRunner"/>
        <xdebugger.breakpointType implementation="com.gpudev.accelerator.debugger.CudaLineBreakpointType"/>
        
        <!-- Profiler -->
        <toolWindow id="GPU Profiler" anchor="bottom" icon="/icons/profiler.svg"
                    factoryClass="com.gpudev.accelerator.profiler.ProfilerToolWindowFactory"/>
        
        <!-- Settings -->
        <applicationConfigurable parentId="tools" 
                                 instance="com.gpudev.accelerator.settings.GPUDevSettingsConfigurable"
                                 id="com.gpudev.accelerator.settings"
                                 displayName="GPU Dev Accelerator"/>
        
        <!-- Inspections -->
        <localInspection language="CUDA" shortName="CudaMemoryLeak"
                        bundle="messages.GPUDevBundle"
                        key="inspection.cuda.memory.leak"
                        groupName="CUDA"
                        enabledByDefault="true"
                        level="WARNING"
                        implementationClass="com.gpudev.accelerator.inspections.CudaMemoryLeakInspection"/>
        
        <localInspection language="CUDA" shortName="CudaKernelOptimization"
                        bundle="messages.GPUDevBundle"
                        key="inspection.cuda.kernel.optimization"
                        groupName="CUDA"
                        enabledByDefault="true"
                        level="WEAK WARNING"
                        implementationClass="com.gpudev.accelerator.inspections.CudaKernelOptimizationInspection"/>
        
        <!-- Run Configurations -->
        <configurationType implementation="com.gpudev.accelerator.run.CudaConfigurationType"/>
        <configurationType implementation="com.gpudev.accelerator.run.MetalConfigurationType"/>
        
        <!-- License -->
        <applicationService serviceImplementation="com.gpudev.accelerator.license.LicenseManager"/>
        
        <!-- Premium Features -->
        <projectService serviceImplementation="com.gpudev.accelerator.premium.PremiumFeatureGate"/>
    </extensions>

    <actions>
        <group id="GPUDev.MainMenu" text="GPU Dev" description="GPU Development Tools">
            <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu"/>
            
            <!-- Free Features -->
            <action id="GPUDev.CompileCuda" class="com.gpudev.accelerator.actions.CompileCudaAction"
                    text="Compile CUDA" description="Compile CUDA source files">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
            </action>
            
            <action id="GPUDev.ShowGPUInfo" class="com.gpudev.accelerator.actions.ShowGPUInfoAction"
                    text="GPU Information" description="Show available GPU devices"/>
            
            <separator/>
            
            <!-- Premium Features -->
            <group id="GPUDev.PremiumFeatures" text="Premium Features" description="Professional GPU Development Tools" popup="true">
                <action id="GPUDev.AdvancedDebug" class="com.gpudev.accelerator.actions.AdvancedDebugAction"
                        text="Advanced CUDA Debug 💎" description="Start advanced debugging with cuda-gdb">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt D"/>
                </action>
                
                <action id="GPUDev.ProfileWithFlameGraph" class="com.gpudev.accelerator.actions.ProfileWithFlameGraphAction"
                        text="Profile with Flame Graph 💎" description="Real-time profiling with flame graphs">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt P"/>
                </action>
                
                <action id="GPUDev.AIOptimizeKernel" class="com.gpudev.accelerator.actions.AIOptimizeKernelAction"
                        text="AI Optimize Kernel 💎" description="Get AI-powered optimization suggestions">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt O"/>
                </action>
                
                <action id="GPUDev.VisualizeMultiGPU" class="com.gpudev.accelerator.actions.VisualizeMultiGPUAction"
                        text="Multi-GPU Topology 💎" description="Visualize GPU topology and workload distribution">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G"/>
                </action>
                
                <action id="GPUDev.AdvancedMemoryCheck" class="com.gpudev.accelerator.actions.AdvancedMemoryCheckAction"
                        text="Advanced Memory Analysis 💎" description="Detect memory leaks and race conditions">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt M"/>
                </action>
            </group>
            
            <separator/>
            
            <action id="GPUDev.MemoryCheck" class="com.gpudev.accelerator.actions.MemoryCheckAction"
                    text="Basic Memory Check" description="Run basic cuda-memcheck"/>
            
            <action id="GPUDev.OptimizeKernel" class="com.gpudev.accelerator.actions.OptimizeKernelAction"
                    text="Basic Kernel Optimization" description="Get basic optimization suggestions">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift O"/>
            </action>
            
            <action id="GPUDev.ProfileKernel" class="com.gpudev.accelerator.actions.ProfileKernelAction"
                    text="Basic Profiling" description="Profile GPU kernel performance">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift P"/>
            </action>
        </group>
    </actions>
</idea-plugin>
